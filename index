<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GSI Vision 2047 Dashboard</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .gsi-blue { background-color: #1e3a8a; } /* Dark Blue */
        .gsi-light { background-color: #eff6ff; }
        .card { transition: transform 0.2s; }
        .card:hover { transform: translateY(-2px); }
    </style>
</head>
<body class="bg-gray-100 text-slate-800">

    <div id="app" class="flex flex-col min-h-screen">
        
        <header class="gsi-blue text-white p-4 shadow-lg">
            <div class="container mx-auto flex items-center justify-between">
                <div class="flex items-center space-x-4">
                    <div class="bg-white p-1 rounded-full">
                        <i class="fa-solid fa-earth-americas text-blue-800 text-3xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold">GSI Vision 2047</h1>
                        <p class="text-sm opacity-90">Geological Survey of India Strategic Roadmap</p>
                    </div>
                </div>
                <div class="hidden md:block text-right text-xs opacity-75">
                    <p>Generated from "Vision 2047 – Geological Survey of India (GSI).pdf"</p>
                </div>
            </div>
        </header>

        <main class="container mx-auto flex-grow p-6 flex flex-col md:flex-row gap-6">
            
            <aside class="w-full md:w-1/4 space-y-6">
                <div class="bg-white p-5 rounded-lg shadow-md border-t-4 border-blue-800">
                    <h2 class="text-lg font-bold mb-4 flex items-center">
                        <i class="fa-solid fa-filter mr-2"></i> Filters
                    </h2>
                    
                    <div class="mb-4">
                        <label class="block text-sm font-semibold mb-2 text-gray-600">Timeline</label>
                        <div class="space-y-2">
                            <label v-for="time in uniqueTimelines" :key="time" class="flex items-center space-x-2 cursor-pointer">
                                <input type="checkbox" :value="time" v-model="selectedTimelines" class="form-checkbox text-blue-800 rounded">
                                <span class="text-sm">{{ time }}</span>
                            </label>
                        </div>
                    </div>

                    <hr class="border-gray-200 my-4">

                    <div>
                        <label class="block text-sm font-semibold mb-2 text-gray-600">Strategic Pillars</label>
                        <div class="space-y-2 max-h-64 overflow-y-auto">
                            <label v-for="pillar in uniquePillars" :key="pillar" class="flex items-center space-x-2 cursor-pointer">
                                <input type="checkbox" :value="pillar" v-model="selectedPillars" class="form-checkbox text-blue-800 rounded">
                                <span class="text-xs">{{ pillar }}</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="bg-blue-50 p-5 rounded-lg shadow-md border border-blue-100">
                    <h3 class="font-bold text-blue-900 mb-2"><i class="fa-solid fa-eye mr-1"></i> Vision Statement</h3>
                    <p class="text-xs italic text-gray-700 leading-relaxed">
                        [cite_start]"To develop into a world-class, innovative, and agile multi-disciplinary geoscience institution that empowers India with foundational, objective, and actionable geological knowledge..." [cite: 42]
                    </p>
                </div>
            </aside>

            <section class="w-full md:w-3/4 space-y-6">
                
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-white p-4 rounded-lg shadow card border-l-4 border-indigo-500">
                        <p class="text-xs text-gray-500 uppercase font-bold">Total Goals</p>
                        <p class="text-2xl font-bold text-indigo-700">{{ filteredData.length }}</p>
                    </div>
                    <div class="bg-white p-4 rounded-lg shadow card border-l-4 border-emerald-500">
                        <p class="text-xs text-gray-500 uppercase font-bold">Critical Mineral</p>
                        <p class="text-2xl font-bold text-emerald-700">{{ mineralGoalsCount }}</p>
                    </div>
                    <div class="bg-white p-4 rounded-lg shadow card border-l-4 border-amber-500">
                        <p class="text-xs text-gray-500 uppercase font-bold">Tech & AI</p>
                        <p class="text-2xl font-bold text-amber-700">{{ techGoalsCount }}</p>
                    </div>
                    <div class="bg-white p-4 rounded-lg shadow card border-l-4 border-rose-500">
                        <p class="text-xs text-gray-500 uppercase font-bold">2047 Targets</p>
                        <p class="text-2xl font-bold text-rose-700">{{ vision2047Count }}</p>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md min-h-[500px]">
                    <div class="flex border-b border-gray-200">
                        <button @click="activeTab = 'visualizer'" :class="{'border-b-2 border-blue-800 text-blue-800 font-bold': activeTab === 'visualizer'}" class="px-6 py-3 text-sm focus:outline-none hover:bg-gray-50 transition">
                            <i class="fa-solid fa-chart-pie mr-2"></i> Visualizer
                        </button>
                        <button @click="activeTab = 'table'" :class="{'border-b-2 border-blue-800 text-blue-800 font-bold': activeTab === 'table'}" class="px-6 py-3 text-sm focus:outline-none hover:bg-gray-50 transition">
                            <i class="fa-solid fa-table mr-2"></i> Data Table
                        </button>
                        <button @click="activeTab = 'minerals'" :class="{'border-b-2 border-blue-800 text-blue-800 font-bold': activeTab === 'minerals'}" class="px-6 py-3 text-sm focus:outline-none hover:bg-gray-50 transition">
                            <i class="fa-solid fa-gem mr-2"></i> Deep Dive: Minerals
                        </button>
                    </div>

                    <div class="p-6">
                        
                        <div v-show="activeTab === 'visualizer'">
                            <div class="mb-6">
                                <h3 class="font-bold text-gray-700 mb-2">Roadmap Timeline</h3>
                                <div id="scatterPlot" class="w-full h-96"></div>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <h3 class="font-bold text-gray-700 mb-2">Focus Areas Distribution</h3>
                                    <div id="pieChart" class="w-full h-64"></div>
                                </div>
                                <div class="bg-gray-50 p-4 rounded text-sm">
                                    <h4 class="font-bold mb-2">Key Insights from PDF:</h4>
                                    <ul class="list-disc pl-5 space-y-2 text-gray-700">
                                        [cite_start]<li><strong>Short Term (0-5 Yrs):</strong> Heavy focus on establishing new tech infrastructure (DPIIC, GPU facility) and mapping (NGPM)[cite: 121, 130].</li>
                                        [cite_start]<li><strong>Medium Term (0-10 Yrs):</strong> Transition to predictive mapping and expanding landslide forecasting[cite: 124, 138].</li>
                                        [cite_start]<li><strong>Long Term (2047):</strong> Achieving the "3D/4D Map of India" and full robotics integration[cite: 124, 130].</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div v-show="activeTab === 'table'">
                            <div class="overflow-x-auto">
                                <table class="min-w-full text-sm text-left text-gray-500">
                                    <thead class="text-xs text-gray-700 uppercase bg-gray-50">
                                        <tr>
                                            <th class="px-4 py-3">Pillar</th>
                                            <th class="px-4 py-3">Goal</th>
                                            <th class="px-4 py-3">Timeline</th>
                                            <th class="px-4 py-3 text-center">Year</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr v-for="(item, index) in filteredData" :key="index" class="bg-white border-b hover:bg-gray-50">
                                            <td class="px-4 py-3 font-medium text-gray-900">{{ item.Pillar }}</td>
                                            <td class="px-4 py-3">{{ item.Goal }}</td>
                                            <td class="px-4 py-3">
                                                <span :class="getBadgeClass(item.Timeline)" class="px-2 py-1 rounded-full text-xs text-white">
                                                    {{ item.Timeline }}
                                                </span>
                                            </td>
                                            <td class="px-4 py-3 text-center font-bold">{{ item.Year }}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div v-show="activeTab === 'minerals'" class="space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="bg-amber-50 p-6 rounded-lg border border-amber-200">
                                    <h3 class="text-xl font-bold text-amber-800 mb-4"><i class="fa-solid fa-bolt"></i> Energy Transition</h3>
                                    <ul class="space-y-3 text-sm text-amber-900">
                                        [cite_start]<li><strong class="text-amber-700">Lithium & Cobalt:</strong> Aggressive exploration in pegmatite belts[cite: 121].</li>
                                        [cite_start]<li><strong class="text-amber-700">Natural Hydrogen:</strong> Exploration for 'White Hydrogen' reservoirs[cite: 121].</li>
                                        [cite_start]<li><strong class="text-amber-700">Coal Innovation:</strong> Research on converting coal to oil (CTL) and using coal-derived anodes for Li-ion batteries[cite: 121].</li>
                                    </ul>
                                </div>
                                <div class="bg-indigo-50 p-6 rounded-lg border border-indigo-200">
                                    <h3 class="text-xl font-bold text-indigo-800 mb-4"><i class="fa-solid fa-layer-group"></i> Advanced Mapping</h3>
                                    <ul class="space-y-3 text-sm text-indigo-900">
                                        [cite_start]<li><strong class="text-indigo-700">Deep Seated:</strong> 2-D Seismic & Magnetotelluric (MT) surveys[cite: 124].</li>
                                        [cite_start]<li><strong class="text-indigo-700">Offshore:</strong> Marine Gravimeter & ROV upgrades for coastal surveys[cite: 130].</li>
                                        [cite_start]<li><strong class="text-indigo-700">Subsurface Map:</strong> Creation of a "Subsurface Critical Mineral Map" of India by 2039[cite: 124].</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </section>
        </main>
        
        <footer class="gsi-blue text-white text-center py-4 text-xs">
            <p>&copy; 2025 Dashboard Generated for GSI Vision 2047 Analysis</p>
        </footer>
    </div>

    <script>
        const { createApp, ref, computed, onMounted, watch } = Vue;

        createApp({
            setup() {
                // --- DATA ---
                const rawData = [
                    { Pillar: "1. Economic Geology", Goal: "National Geophysical Mapping (NGPM)", Timeline: "Short Term (0-5 Yrs)", Year: 2029 },
                    { Pillar: "1. Economic Geology", Goal: "Pegmatite Mapping of India", Timeline: "Short Term (0-5 Yrs)", Year: 2029 },
                    { Pillar: "1. Economic Geology", Goal: "Critical Mineral Exploration (On/Off-shore)", Timeline: "Short Term (0-5 Yrs)", Year: 2029 },
                    { Pillar: "1. Economic Geology", Goal: "Natural Hydrogen (White H2) Exploration", Timeline: "Short Term (0-5 Yrs)", Year: 2029 },
                    { Pillar: "1. Economic Geology", Goal: "Stratigraphic Drilling (up to 2 km)", Timeline: "Medium Term (0-10 Yrs)", Year: 2034 },
                    { Pillar: "1. Economic Geology", Goal: "3D/4D Map of India", Timeline: "Long Term (2047)", Year: 2047 },
                    { Pillar: "2. Tech Transformation", Goal: "Setup Data Processing Centre (DPIIC)", Timeline: "Short Term (0-5 Yrs)", Year: 2029 },
                    { Pillar: "2. Tech Transformation", Goal: "GPU-based Compute Facility", Timeline: "Short Term (0-5 Yrs)", Year: 2029 },
                    { Pillar: "2. Tech Transformation", Goal: "IndiaAI-Geoscience-Hackathon", Timeline: "Short Term (0-5 Yrs)", Year: 2029 },
                    { Pillar: "2. Tech Transformation", Goal: "Robotics for Inaccessible Terrain", Timeline: "Long Term (0-15 Yrs)", Year: 2039 },
                    { Pillar: "3. Public Good", Goal: "Regional Landslide Forecasting (30 Dists)", Timeline: "Short Term (0-5 Yrs)", Year: 2029 },
                    { Pillar: "3. Public Good", Goal: "Planetary Mapping (Moon/Mars)", Timeline: "Short Term (0-5 Yrs)", Year: 2029 },
                    { Pillar: "3. Public Good", Goal: "Regional Landslide Forecasting (181 Dists)", Timeline: "Long Term (2047)", Year: 2047 },
                    { Pillar: "4. Global Partnerships", Goal: "India 'Geoethics Charter'", Timeline: "Short Term (0-5 Yrs)", Year: 2029 },
                    { Pillar: "4. Global Partnerships", Goal: "IndPROBE (Deep Geology Lithosphere)", Timeline: "Long Term (2047)", Year: 2047 },
                    { Pillar: "5. Data Infrastructure", Goal: "National Geoscience Data Repository", Timeline: "Short Term (0-5 Yrs)", Year: 2029 },
                    { Pillar: "5. Data Infrastructure", Goal: "India's Geoscience Atlas 2047", Timeline: "Long Term (2047)", Year: 2047 },
                    { Pillar: "6. Training", Goal: "Launch GSI TI Degree Program", Timeline: "Short Term (0-5 Yrs)", Year: 2029 },
                    { Pillar: "6. Training", Goal: "GSI TI as UNESCO Centre of Excellence", Timeline: "Long Term (0-15 Yrs)", Year: 2039 },
                    { Pillar: "7. Policy Intervention", Goal: "Global Leader in Geoscience", Timeline: "Long Term (0-15 Yrs)", Year: 2039 }
                ];

                // --- STATE ---
                const activeTab = ref('visualizer');
                const selectedTimelines = ref([...new Set(rawData.map(d => d.Timeline))]);
                const selectedPillars = ref([...new Set(rawData.map(d => d.Pillar))]);

                // --- COMPUTED ---
                const uniqueTimelines = computed(() => [...new Set(rawData.map(d => d.Timeline))]);
                const uniquePillars = computed(() => [...new Set(rawData.map(d => d.Pillar))]);

                const filteredData = computed(() => {
                    return rawData.filter(d => 
                        selectedTimelines.value.includes(d.Timeline) && 
                        selectedPillars.value.includes(d.Pillar)
                    );
                });

                const mineralGoalsCount = computed(() => filteredData.value.filter(d => d.Pillar.includes('Economic')).length);
                const techGoalsCount = computed(() => filteredData.value.filter(d => d.Pillar.includes('Tech')).length);
                const vision2047Count = computed(() => filteredData.value.filter(d => d.Year === 2047).length);

                // --- METHODS ---
                const getBadgeClass = (timeline) => {
                    if (timeline.includes('Short')) return 'bg-emerald-500';
                    if (timeline.includes('Medium')) return 'bg-blue-500';
                    return 'bg-purple-600';
                };

                const updateCharts = () => {
                    if (activeTab.value !== 'visualizer') return;

                    // Scatter Plot
                    const trace1 = {
                        x: filteredData.value.map(d => d.Year),
                        y: filteredData.value.map(d => d.Pillar),
                        mode: 'markers',
                        type: 'scatter',
                        text: filteredData.value.map(d => d.Goal),
                        marker: { size: 14, color: '#1e3a8a', opacity: 0.7 }
                    };
                    
                    const layout1 = {
                        title: 'Goals by Year',
                        margin: { t: 30, b: 40, l: 150, r: 20 },
                        xaxis: { title: 'Target Year', dtick: 5 },
                        yaxis: { automargin: true }
                    };

                    Plotly.newPlot('scatterPlot', [trace1], layout1, {responsive: true});

                    // Pie Chart
                    const pillarCounts = {};
                    filteredData.value.forEach(d => {
                        pillarCounts[d.Pillar] = (pillarCounts[d.Pillar] || 0) + 1;
                    });

                    const trace2 = {
                        values: Object.values(pillarCounts),
                        labels: Object.keys(pillarCounts),
                        type: 'pie',
                        marker: { colors: ['#059669', '#2563eb', '#d97706', '#dc2626', '#7c3aed', '#db2777', '#4b5563'] }
                    };

                    const layout2 = {
                        margin: { t: 20, b: 20, l: 20, r: 20 },
                        showlegend: false
                    };

                    Plotly.newPlot('pieChart', [trace2], layout2, {responsive: true});
                };

                // --- WATCHERS ---
                watch([filteredData, activeTab], () => {
                    setTimeout(updateCharts, 100); // Small delay to ensure DOM is ready
                });

                onMounted(() => {
                    updateCharts();
                });

                return {
                    activeTab,
                    uniqueTimelines,
                    uniquePillars,
                    selectedTimelines,
                    selectedPillars,
                    filteredData,
                    mineralGoalsCount,
                    techGoalsCount,
                    vision2047Count,
                    getBadgeClass
                };
            }
        }).mount('#app');
    </script>
</body>
</html>
